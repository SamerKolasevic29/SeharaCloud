# ============================================================
# SeharaCloud - environment configuration
# ============================================================

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
POSTGRES_USER=clouduser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=seharacloud-db

# Internal database hostname/port within the Docker network (usually left as default)
DB_HOST=seharacloud-db
DB_PORT=5432

# ------------------------------------------------------------
# API (SeharaCloud.api)
# ------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# Port the API listens on inside the container
API_PORT=5000

# Which host interface the port is published on (127.0.0.1 = local only,
# e.g., behind a reverse proxy; 0.0.0.0 = publicly accessible)
API_BIND_ADDRESS=127.0.0.1

# Public URL where the API is accessible - used for constructing
# ThumbnailUrl and similar absolute links (AppSettings:BaseUrl)
# Example: https://sehara.cloud.com
API_BASE_URL=https://sehara.cloud.com

# ------------------------------------------------------------
# Indexer (C++ inotify daemon)
# ------------------------------------------------------------
# Paths AS SEEN BY THE CONTAINER (usually left as default)
INDEXER_PHYSICAL_BASE_PATH=/data/seharacloud/media
INDEXER_LOGICAL_BASE_PATH=/mnt/cloud

# ------------------------------------------------------------
# Host paths (where data actually resides on the server)
# Adjust this for your server if it doesn't match /data/seharacloud/*
# ------------------------------------------------------------
HOST_MEDIA_PATH=/data/seharacloud/media
HOST_DB_DATA_PATH=/data/seharacloud/db-data